<section class="slogan" aria-label="Uzņēmuma sauklis">
  <div class="wrap">
    <p class="slogan__t reveal">{{ site.tagline }}.</p>
  </div>
</section>

<footer class="ftr">
  <div class="wrap ftr__in">
    <div class="ftr__co">
      <span class="brand__mark brand__mark--ftr" role="img" aria-label="Vārtu pasaule"><span class="brand__a" aria-hidden="true">vārtu</span><span class="brand__b" aria-hidden="true">pasaule</span></span>
      <p class="ftr__req">{{ site.legal_name }} &middot; Reģ. nr. {{ site.reg_nr }} &middot; PVN nr. {{ site.pvn_nr }}</p>
      <p class="ftr__req">Dibināts {{ site.founded_date_lv }} &middot; {{ site.address.full }}</p>
      <p class="ftr__req ftr__req--con">
        <a class="lnk" href="{{ site.phones[0].number | telHref }}">{{ site.phones[0].number }}</a>
        <a class="lnk" href="mailto:{{ site.email }}">{{ site.email }}</a>
      </p>
    </div>

    <nav class="ftr__nav" aria-label="Pakalpojumi">
      <p class="ftr__h">Pakalpojumi</p>
      {% for g in collections.gates %}
      <a href="/{{ g.data.slug }}/">{{ g.data.title }}</a>
      {% endfor %}
    </nav>

    <nav class="ftr__nav" aria-label="Uzņēmums">
      <p class="ftr__h">Uzņēmums</p>
      <a href="/galerija/">Darbu galerija</a>
      <a href="/par-mums/">Par mums</a>
      <a href="/kontakti/">Kontakti</a>
      <a href="/privatuma-politika/">Privātuma politika</a>
    </nav>
  </div>

  <div class="wrap ftr__b">
    <p class="ftr__note">&copy; {% year %} {{ site.legal_name }}. Visas tiesības aizsargātas.</p>
  </div>
</footer>
