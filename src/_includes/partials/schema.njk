<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["HomeAndConstructionBusiness", "LocalBusiness"],
      "@id": "{{ site.url }}/#business",
      "name": "{{ site.brand }}",
      "legalName": "{{ site.legal_name | jsonStr }}",
      "description": "{{ site.description | jsonStr }}",
      "slogan": "{{ site.tagline | jsonStr }}",
      "url": "{{ site.url }}/",
      "foundingDate": "{{ site.founded_date }}",
      "vatID": "{{ site.pvn_nr }}",
      "taxID": "{{ site.reg_nr }}",
      "telephone": "{{ site.phones[0].number }}",
      "email": "{{ site.email }}",
      "currenciesAccepted": "EUR",
      "knowsLanguage": "lv",
      "image": "{{ site.url }}/assets/img/hero.webp",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "{{ site.address.street | jsonStr }}",
        "addressLocality": "Nītaure",
        "addressRegion": "{{ site.address.region }}",
        "postalCode": "{{ site.address.postal_code }}",
        "addressCountry": "LV"
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
          "opens": "08:00",
          "closes": "20:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "Sunday",
          "opens": "09:00",
          "closes": "19:00"
        }
      ],
      "contactPoint": [
        {% for p in site.phones %}{ "@type": "ContactPoint", "contactType": "customer service", "telephone": "{{ p.number }}", "availableLanguage": "lv" }{% if not loop.last %},{% endif %}
        {% endfor %}
      ],
      "areaServed": [
        {% for c in site.geo_core %}{% set cn = c.name or c %}{% if cn != "visa Vidzeme" %}{ "@type": "City", "name": "{{ cn }}" },{% endif %}{% endfor %}
        {% for c in site.geo_wider %}{ "@type": "City", "name": "{{ c.name or c }}" },{% endfor %}
        { "@type": "AdministrativeArea", "name": "Vidzeme" },
        { "@type": "AdministrativeArea", "name": "{{ site.address.region }}" }
      ],
      "sameAs": [
        {% for u in site.catalog_profiles %}"{{ u.url or u }}"{% if not loop.last %},{% endif %}{% endfor %}
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Vārti, durvis un serviss",
        "itemListElement": [
          {% for g in collections.gates %}
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "name": "{{ g.data.title | jsonStr }}",
              "description": "{{ g.data.summary | jsonStr }}",
              "url": "{{ site.url }}/{{ g.data.slug }}/",
              "provider": { "@id": "{{ site.url }}/#business" }
            }
          }{% if not loop.last %},{% endif %}
          {% endfor %}
        ]
      }
    },
    {
      "@type": "WebSite",
      "@id": "{{ site.url }}/#website",
      "url": "{{ site.url }}/",
      "name": "{{ site.brand }}",
      "inLanguage": "lv",
      "publisher": { "@id": "{{ site.url }}/#business" }
    }{% if breadcrumb %},
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Sākums", "item": "{{ site.url }}/" },
        { "@type": "ListItem", "position": 2, "name": "{{ title | jsonStr }}", "item": "{{ site.url }}{{ page.url }}" }
      ]
    }{% endif %}
  ]
}
</script>
